# ==============================================================================
# AI-POWERED IT SERVICE MANAGEMENT PLATFORM ENVIRONMENT VARIABLES
# ==============================================================================

# System Configuration
PROJECT_NAME="AI-Powered ITSM Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_APP_TITLE="AI ITSM Enterprise Platform"

# Backend Configuration
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
SECRET_KEY="replace_with_a_secure_jwt_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="itsm_admin"
POSTGRES_PASSWORD="itsm_password_123"
POSTGRES_DB="itsm_db"
DATABASE_URL="postgresql+asyncpg://itsm_admin:itsm_password_123@localhost:5432/itsm_db"

# AI Engine Configuration
AI_PROVIDER="mock" # Options: mock, openai, anthropic, gemini
AI_MOCK_DELAY_SECONDS=0.5
OPENAI_API_KEY="sk-mock-key-for-development"
LLM_MODEL="gpt-4-turbo"

# Notification Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@itsm-platform.local"
SMTP_PASSWORD="mock-smtp-password"

# Redis Cache (Optional for task queue & caching)
REDIS_HOST="localhost"
REDIS_PORT=6379
