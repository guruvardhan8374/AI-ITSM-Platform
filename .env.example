# ==============================================================================
# AI-POWERED IT SERVICE MANAGEMENT PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Project & System Metadata
PROJECT_NAME="AI-Powered ITSM Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Service Port Mappings (Docker / Local)
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# Frontend Configuration
FRONTEND_API_URL="http://localhost:8000/api/v1"
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_APP_TITLE="AI ITSM Enterprise Platform"

# Backend Authentication & Security (Academic / Demo Defaults)
SECRET_KEY="super_secret_jwt_key_itsm_platform_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL in Docker / SQLite Fallback in Local Dev)
USE_SQLITE=false
POSTGRES_SERVER="postgres"
POSTGRES_USER="itsm_admin"
POSTGRES_PASSWORD="itsm_password_123"
POSTGRES_DB="itsm_db"
DATABASE_URL="postgresql+asyncpg://itsm_admin:itsm_password_123@postgres:5432/itsm_db"

# pgAdmin Management Tool (Academic / Demo Credentials)
PGADMIN_DEFAULT_EMAIL="admin@itsm.local"
PGADMIN_DEFAULT_PASSWORD="admin_password_123"

# AI Engine Configuration
AI_PROVIDER="mock" # Options: mock, openai, anthropic, gemini
AI_MOCK_DELAY_SECONDS=0.5
OPENAI_API_KEY="sk-mock-key-for-development"
LLM_MODEL="gpt-4-turbo"
